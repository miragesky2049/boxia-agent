# 复制为 ops/.env.test 后填写；该文件包含密钥，禁止提交到仓库。
APP_ENV=test
APP_NAME=boxia-agent
APP_VERSION=1.0.0

# PostgreSQL：DATABASE_URL 中的账号密码必须与 POSTGRES_* 一致
POSTGRES_DB=boxia_test
POSTGRES_USER=boxia
POSTGRES_PASSWORD=CHANGE_ME_TEST_DB_PASSWORD

DATABASE_URL=postgresql+psycopg://boxia:CHANGE_ME_TEST_DB_PASSWORD@db:5432/boxia_test
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800
STATEMENT_TIMEOUT_MS=5000
LOCK_TIMEOUT_MS=3000

# 认证：使用 openssl rand -hex 32 生成，至少 32 字符
JWT_SECRET=CHANGE_ME_TEST_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=boxia-agent
JWT_AUDIENCE=boxia-admin
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# 多租户域名（测试环境必填）：每个环境使用独立泛域名
# 需将 *.test.example.com 解析到本机，包含 adminsystem.test.example.com
ROOT_DOMAIN=test.example.com
PLATFORM_ADMIN_SUBDOMAIN=adminsystem
PLATFORM_NAME=Agent运营管理平台
DEFAULT_TENANT_CODE=
# 测试环境只认域名，请求头切换仅本地调试可用；开启会导致启动失败
ALLOW_TENANT_HEADER=false

CORS_ORIGINS=
DOCS_ENABLED=true
LEGACY_API_ENABLED=true

LOG_LEVEL=INFO
LOG_JSON=false

# OpenTelemetry（可选）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=boxia-agent
OTEL_TRACES_SAMPLER_RATIO=1.0

WEB_CONCURRENCY=1
HTTP_PORT=8082
