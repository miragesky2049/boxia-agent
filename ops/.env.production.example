# 复制为 ops/.env.production 后填写；该文件包含密钥，禁止提交到仓库。
APP_ENV=production
APP_NAME=boxia-agent
APP_VERSION=1.0.0

# PostgreSQL：DATABASE_URL 中的账号密码必须与 POSTGRES_* 一致
POSTGRES_DB=boxia
POSTGRES_USER=boxia
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

DATABASE_URL=postgresql+psycopg://boxia:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/boxia
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800
STATEMENT_TIMEOUT_MS=5000
LOCK_TIMEOUT_MS=3000

# 认证：使用 openssl rand -hex 32 生成，至少 32 字符
JWT_SECRET=CHANGE_ME_64_HEX_CHARACTERS
JWT_ISSUER=boxia-agent
JWT_AUDIENCE=boxia-admin
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# 多租户域名（生产必填）：根域名 + 产品级平台子域名
# 每个环境使用独立泛域名，例如开发 dev.example.com、测试 test.example.com、线上 example.com；
# 需将 *.ROOT_DOMAIN 解析到本机（含 adminsystem），泛域名证书也按环境分别申请。
ROOT_DOMAIN=example.com
PLATFORM_ADMIN_SUBDOMAIN=adminsystem
PLATFORM_NAME=Agent运营管理平台
# 根域名访问默认进入的租户编码（留空则拒绝根域名访问）
DEFAULT_TENANT_CODE=
# 部署环境一律通过二级域名识别租户；请求头切换仅用于本地调试，生产开启会导致启动失败
ALLOW_TENANT_HEADER=false

# 同源部署可留空；如前后端分离，填写管理端域名，逗号分隔，禁止 *
CORS_ORIGINS=

# 生产默认关闭 Swagger；保留 /api 兼容别名
DOCS_ENABLED=false
LEGACY_API_ENABLED=true

# 用户端接口令牌（骨架接口使用，需 >= 32 字符；不启用可留空）
# USER_API_TOKEN=

LOG_LEVEL=INFO
LOG_JSON=true

# OpenTelemetry（可选）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=boxia-agent
OTEL_TRACES_SAMPLER_RATIO=0.1

# 后端 worker 数
WEB_CONCURRENCY=2

# 对外 HTTP 端口
HTTP_PORT=80
