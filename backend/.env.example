# ============================================================
# 一、必填项（首次使用请优先逐项确认）
# 缺失、格式错误或使用示例值会导致应用启动失败
# ============================================================

# 运行环境：local | dev | test | prod
# local=本机调试，ROOT_DOMAIN 可留空自动回退 localhost
# dev/test/prod=部署环境，强制配置独立泛域名，且禁止开启请求头切换
APP_ENV=local

# PostgreSQL 连接串：必填，数据库不可达时启动直接失败
# 本地库可在仓库根目录执行：docker compose -f backend/docker/docker-compose.yml up -d
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/boxia_agent

# 认证签名密钥：必填，使用 openssl rand -hex 32 生成
# 生产环境要求不少于 32 字符，且禁止使用示例值（如 dev-jwt-secret-change-me-...），否则拒绝启动
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef

# 多租户根域名：部署环境必填，local 可留空
# local 推荐 localhost：无需配置 DNS 即可用 adminsystem.localhost / acme.localhost 验证真实子域名
# 部署环境使用独立泛域名（dev.example.com / test.example.com / example.com），不能是 localhost 或 IP，
# 并需将 *.<ROOT_DOMAIN>（含 adminsystem）解析到服务端
ROOT_DOMAIN=localhost

# ============================================================
# 二、多租户平台标识（有默认值，部署前请确认）
# ============================================================

# 产品级平台子域名：产品级后台固定为 <PLATFORM_ADMIN_SUBDOMAIN>.<ROOT_DOMAIN>
# 仅允许一级子域名标签（小写字母、数字、中划线）
PLATFORM_ADMIN_SUBDOMAIN=adminsystem

# 平台展示名称
PLATFORM_NAME=AI智能体运营管理平台

# 根域名访问时默认进入的租户编码（留空则拒绝根域名访问）
DEFAULT_TENANT_CODE=

# 是否允许 X-Tenant-Code 请求头覆盖作用域，仅 local 环境可用
# local：http://localhost:5173/login?tenant=acme 走请求头；http://acme.localhost:5173 走子域名
# dev/test/prod 只认域名，开启该项会导致启动校验失败
ALLOW_TENANT_HEADER=true

# ============================================================
# 三、数据库连接池与语句超时（可选，按实例规格调整）
# ============================================================

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800
STATEMENT_TIMEOUT_MS=5000
LOCK_TIMEOUT_MS=3000

# ============================================================
# 四、令牌与登录策略（可选）
# ============================================================

# 访问令牌有效期（分钟）
ACCESS_TOKEN_MINUTES=30
# 刷新令牌有效期（天）
REFRESH_TOKEN_DAYS=14
# bcrypt 计算强度（4-16，越大越慢、越安全）
BCRYPT_ROUNDS=12
# 连续登录失败达到该次数后锁定账号
LOGIN_MAX_ATTEMPTS=5
# 账号锁定时长（分钟）
LOGIN_LOCK_MINUTES=15

# 密码策略：后端校验与前端表单统一读取此处配置，改这里即可全局生效
# 最小长度（字符数，8-64）
PASSWORD_MIN_LENGTH=10
# 最大字节数（UTF-8，32-72；bcrypt 只处理前 72 字节）
PASSWORD_MAX_BYTES=72
# 至少包含的字符类别数（1-4：大写字母、小写字母、数字、符号）
PASSWORD_MIN_CATEGORIES=3

# 技能包配额：文本类技能包，按文件数/单文件/总大小三重限制
# 单个技能包最大文件数（1-2000）
SKILL_PACKAGE_MAX_FILES=200
# 单个文件最大字节数（1KiB-16MiB）
SKILL_PACKAGE_MAX_FILE_BYTES=1048576
# 单个技能包总大小上限（1KiB-64MiB）
SKILL_PACKAGE_MAX_TOTAL_BYTES=8388608

# ============================================================
# 五、跨域与接口暴露（按部署形态调整）
# ============================================================

# 站点跨域白名单（admin/user 共用，逗号分隔，留空表示不启用 CORS；生产不允许 *）
CORS_ORIGINS=

# Swagger 文档：留空=生产关闭、其他环境开启
# DOCS_ENABLED=false

# 保留 /api 兼容别名（下一个版本周期移除）
LEGACY_API_ENABLED=true

# ============================================================
# 六、日志与可观测性（可选）
# ============================================================

LOG_LEVEL=INFO
# 日志格式：留空=生产输出 JSON、其他环境输出文本
# LOG_JSON=false

# OpenTelemetry（可选，未配置时开发环境输出到控制台、生产环境不导出）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=boxia-agent
OTEL_TRACES_SAMPLER_RATIO=1.0
