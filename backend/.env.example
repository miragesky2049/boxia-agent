# ============================================================
# 一、必填项（首次使用请优先逐项确认）
# 缺失、格式错误或使用示例值会导致应用启动失败
# ============================================================

# 运行环境：local | dev | test | prod
# local=本机调试，ROOT_DOMAIN 可留空自动回退 localhost
# dev/test/prod=部署环境，强制配置独立泛域名，且禁止开启请求头切换
APP_ENV=local

# PostgreSQL 连接串：必填，数据库不可达时启动直接失败
# 默认值对应仓库自带的 docker compose 起的本地库（pgvector/pgvector:pg17，端口 5432）
# 本地库启动：docker compose -f backend/docker/postgresql/docker-compose.yml up -d
#
# 复用已有 PostgreSQL（本地直装 / 公司内网 / 云托管）时，直接改这一行指向外部地址即可：
#   DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
# 注意：RAG 向量检索依赖 pgvector 扩展，自建库需先在目标库执行：
#   CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/boxia_agent

# 认证签名密钥：必填，使用 openssl rand -hex 32 生成
# 生产环境要求不少于 32 字符，且禁止使用示例值（如 dev-jwt-secret-change-me-...），否则拒绝启动
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef

# 多租户根域名：部署环境必填，local 可留空
# local 推荐 localhost：无需配置 DNS 即可用 platform.localhost / acme.localhost 验证真实子域名
# 部署环境使用独立泛域名（dev.example.com / test.example.com / example.com），不能是 localhost 或 IP，
# 并需将 *.<ROOT_DOMAIN>（含 platform）解析到服务端
ROOT_DOMAIN=localhost

# ============================================================
# 二、多租户平台标识（有默认值，部署前请确认）
# ============================================================

# 产品级平台子域名：产品级后台固定为 <PLATFORM_ADMIN_SUBDOMAIN>.<ROOT_DOMAIN>
# 仅允许一级子域名标签（小写字母、数字、中划线）
PLATFORM_ADMIN_SUBDOMAIN=platform

# 平台展示名称
PLATFORM_NAME=AI智能体运营管理平台

# 根域名访问时默认进入的租户编码（留空则拒绝根域名访问）
DEFAULT_TENANT_CODE=

# 是否允许 X-Tenant-Code 请求头覆盖作用域，仅 local 环境可用
# local：http://localhost:5173/login?tenant=acme 走请求头；http://acme.localhost:5173 走子域名
# dev/test/prod 只认域名，开启该项会导致启动校验失败
ALLOW_TENANT_HEADER=true

# ============================================================
# 三、数据库连接池与语句超时（可选，按实例规格调整）
# ============================================================

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800
STATEMENT_TIMEOUT_MS=5000
LOCK_TIMEOUT_MS=3000

# ============================================================
# 四、令牌与登录策略（可选）
# ============================================================

# 访问令牌有效期（分钟）
ACCESS_TOKEN_MINUTES=30
# 刷新令牌有效期（天）
REFRESH_TOKEN_DAYS=14
# bcrypt 计算强度（4-16，越大越慢、越安全）
BCRYPT_ROUNDS=12
# 连续登录失败达到该次数后锁定账号
LOGIN_MAX_ATTEMPTS=5
# 账号锁定时长（分钟）
LOGIN_LOCK_MINUTES=15

# 密码策略：后端校验与前端表单统一读取此处配置，改这里即可全局生效
# 最小长度（字符数，8-64）
PASSWORD_MIN_LENGTH=10
# 最大字节数（UTF-8，32-72；bcrypt 只处理前 72 字节）
PASSWORD_MAX_BYTES=72
# 至少包含的字符类别数（1-4：大写字母、小写字母、数字、符号）
PASSWORD_MIN_CATEGORIES=3

# ============================================================
# 四.1、平台管理员自动初始化（可选，部署产品级运营平台时开启）
# 与 internal/infrastructure/config/settings.py 中 admin_* 字段一一对应
# ============================================================
# 开启后，admin 站点启动时若 admin_users 表为空，自动创建首个平台管理员账号
# 同时满足两个条件才会真正执行：ADMIN_AUTO_INIT=true 且 ADMIN_INITIAL_PASSWORD 非空
# 也可继续用 scripts/create_admin.py 手动创建
# ADMIN_AUTO_INIT=false
# ADMIN_INITIAL_USERNAME=admin
# ADMIN_INITIAL_DISPLAY_NAME=系统管理员
# ADMIN_INITIAL_PASSWORD=
# ADMIN_INITIAL_ROLE=superadmin
# ADMIN_INITIAL_MUST_CHANGE_PASSWORD=true

# ============================================================
# 五、权益生命周期策略（可选）
# ============================================================

# 取消权益严格模式：true=仍有角色授权引用该权益时整批拒绝（ENTITLEMENT_IN_USE）；
# false=允许强制取消并同步清理引用
ENTITLEMENT_REVOKE_STRICT=false
# 取消权益时是否中断在跑任务：预留开关，当前版本恒为 false，不要开启
ENTITLEMENT_REVOKE_KILL_RUNNING=false
# 到期宽限期天数：expired 后 N 天内保留配置与恢复入口（只读），超期由每日定时任务流转为 revoked；
# 0=关闭宽限期，expired 后直接按 revoked 处理
ENTITLEMENT_GRACE_DAYS=30

# ============================================================
# 六、跨域与接口暴露（按部署形态调整）
# ============================================================

# 站点跨域白名单（admin/user 共用，逗号分隔，留空表示不启用 CORS；生产不允许 *）
CORS_ORIGINS=

# Swagger 文档：留空=生产关闭、其他环境开启
# DOCS_ENABLED=false

# 保留 /api 兼容别名（下一个版本周期移除）
LEGACY_API_ENABLED=true

# ============================================================
# 七、日志与可观测性（可选）
# ============================================================

LOG_LEVEL=INFO
# 日志格式：留空=生产输出 JSON、其他环境输出文本
# LOG_JSON=false

# OpenTelemetry（可选，未配置时开发环境输出到控制台、生产环境不导出）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=boxia-agent
OTEL_TRACES_SAMPLER_RATIO=1.0

# ============================================================
# 八、LLM 运行时配置（开发调试用，生产应切换到内部 LLM 代理）
# ============================================================
# 开发调试直连 DeepSeek（OpenAI 兼容协议）
LLM_API_KEY=
LLM_MODEL_ID=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
# 单次运行最大工具调用轮次，防止失控循环
LLM_MAX_ITERATIONS=6
# 请求超时（秒，浮点）
LLM_TIMEOUT_SECONDS=60.0

# ============================================================
# 九、短期记忆 Redis（多轮对话历史）
# ============================================================
# 默认值对应仓库自带的 docker compose 起的本地 Redis（redis:7-alpine，端口 6379）
# 本地启动：docker compose -f backend/docker/redis/docker-compose.yml up -d
#
# 复用已有 Redis（本地直装 / 公司内网 / 云托管 Redis）时，直接改下面三行指向外部地址：
#   - 短期记忆用 DB 0，Celery broker 用 DB 1，Celery result 用 DB 2，三者需互相隔离
#   - 若外部 Redis 需密码，连接串形如：redis://:<password>@<host>:<port>/<db>
REDIS_URL=redis://127.0.0.1:6379/0
# 单会话最多保留多少轮（user+assistant 对），超出后从头部裁剪
MEMORY_MAX_TURNS=20
# 会话空闲多久后过期（秒）
MEMORY_TTL_SECONDS=1800

# ============================================================
# 十、RAG 知识库（Embedding + 向量检索 + Rerank + Query 改写）
# ============================================================
# Embedding（SiliconFlow 托管 BAAI/bge-large-zh-v1.5，1024 维；未配置 API Key 时 Dataset 节点走 stub）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSIONS=1024
# 请求超时（秒，浮点）
EMBEDDING_TIMEOUT_SECONDS=30.0

# 文档切分（bge 模型最大 512 tokens，chunk_size 不建议超过 500 字符）
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.55

# Rerank（Cross-Encoder 精排，SiliconFlow /v1/rerank）
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_TOP_N=5
# 向量召回倍数：粗排召回 top_k * multiplier 个候选，再交给 rerank 精排
RAG_RECALL_MULTIPLIER=10

# Query 改写（LLM 生成独立 query + N 个同义变体）
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_VARIANTS=3

# 向量库 Provider：memory=开发态内存（重启丢数据，零依赖）；
# pgvector=复用上面的 PostgreSQL（需已装 pgvector 扩展）；milvus=独立集群
VECTOR_STORE_PROVIDER=memory
# 仅 VECTOR_STORE_PROVIDER=milvus 时需要填写
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_TOKEN=

# Celery 异步 ingest（独立 Redis DB，避免与短期记忆混用）
# worker 启动命令：celery -A internal.infrastructure.celery_app worker --loglevel=info -Q rag
# 复用已有 Redis 时，这两行的 host/port/password 必须与上面 REDIS_URL 保持一致，仅 DB 编号不同
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ============================================================
# 十一、大对象存储（MinIO / S3 兼容，可选）
# graph JSONB 超过 1MB 阈值时写入对象存储，DB 只存 URI 引用
# ENDPOINT 留空=不启用对象存储，超过阈值时降级为内联写入 DB 并打 warning
# ============================================================
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=boxia-graphs
# true=使用 https 访问 endpoint
OBJECT_STORAGE_SECURE=false

# ============================================================
# 十二、高级配置（一般无需修改）
# 修改 JWT 签发方/受众/算法会导致已签发令牌全部失效，升级集群时需各实例同步
# ============================================================
# APP_NAME=boxia-agent
# APP_VERSION=1.0.0
# JWT_ALGORITHM=HS256
# JWT_ISSUER=boxia-agent
# 管理端与用户端使用独立受众，避免两类令牌互相冒用
# JWT_AUDIENCE=boxia-admin
# USER_JWT_AUDIENCE=boxia-user
