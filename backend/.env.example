# 运行环境：development | test | production
APP_ENV=development

# PostgreSQL（仓库根目录执行 docker compose -f backend/docker/docker-compose.yml up -d）
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/boxia_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800
STATEMENT_TIMEOUT_MS=5000
LOCK_TIMEOUT_MS=3000

# 认证（生产环境请用 openssl rand -hex 32 生成 JWT_SECRET）
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# 多租户域名：ROOT_DOMAIN 如 example.com；产品级平台固定使用 adminsystem.example.com。
# 留空时只能通过 X-Tenant-Code（开发/测试）识别租户；生产必须配置 ROOT_DOMAIN。
ROOT_DOMAIN=
PLATFORM_ADMIN_SUBDOMAIN=adminsystem
PLATFORM_NAME=Agent运营管理平台
# 根域名访问时默认进入的租户编码（留空则拒绝根域名访问）
DEFAULT_TENANT_CODE=
# 是否允许 X-Tenant-Code 请求头识别租户；留空时生产关闭、其他环境开启
# ALLOW_TENANT_HEADER=true

# 管理端跨域白名单（逗号分隔，留空表示不启用 CORS；生产不允许 *）
CORS_ORIGINS=

# Swagger 文档：留空=生产关闭、其他环境开启
# DOCS_ENABLED=false
# 保留 /api 兼容别名（下一个版本周期移除）
LEGACY_API_ENABLED=true

# 用户端接口令牌（骨架实现，生产环境必须配置且不少于 32 字符）
# USER_API_TOKEN=

# 日志
LOG_LEVEL=INFO
# LOG_JSON=false

# OpenTelemetry（可选，未配置时开发环境输出到控制台、生产环境不导出）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=boxia-agent
OTEL_TRACES_SAMPLER_RATIO=1.0
